    "special_abilities": [
      {
        "name": "Berserk",
        "desc": "Whenever the created starts its turn Bloodied, roll 1d6. On a 6, the created goes berserk. On each of its turns while berserk, the created attacks the nearest creature it can see. If no creature is near enough to move to and attack, the created attacks an object. Once the created goes berserk, it remains so until it is destroyed or it is no longer Bloodied.\nThe created's creator, if within 60 feet of the berserk created, can try to calm it by taking an action to make a DC 15 Charisma (Persuasion) check; the created must be able to hear its creator. If this check succeeds, the created ceases being berserk until the start of its next turn, at which point it resumes rolling for the Berserk trait again if it is still Bloodied."
      },
      {
        "name": "Immutable Form",
        "desc": "The created can't shape-shift."
      },
      {
        "name": "Lightning Absorption",
        "desc": "Whenever the created is subjected to Lightning damage, it regains a number of Hit Points equal to the Lightning damage dealt."
      },
      {
        "name": "Magic Resistance",
        "desc": "The created has Advantage on saving throws against spells and other magical effects."
      }
    ],
    "actions": [
      {
        "name": "Multiattack",
        "desc": "The created makes two Slam attacks."
      },
      {
        "name": "Slam",
        "desc": "m +7, reach 5 ft. Hit: 13 (2d8 + 4) Bludgeoning damage plus 4 (1d8) Lightning damage.",
        "attack_bonus": 7
      },
      {
        "name": "Malfunction (Recharge 6)",
        "desc": "The created randomly creates one of the following effects (roll 1d4):\n1: Insect Hive: con DC 15, each creature within 10 feet.  The creature takes 13 (3d8) Poison damage and has the Poisoned condition until the start of its next turn.\n2: Melting Plastic: dex DC 15, each creature in a 15-foot Cone.  13 (3d8) Fire damage. Until the end of the target's next turn, the target's Speed is halved; the target can't take Reactions; and the target can take either an action or Bonus Action on its turn, not both.  Half damage only\n3: Electrical Discharge: dex DC 15, each creature within 10 feet.  18 (4d8) Lightning damage.  Half damage\n4: Haywire: The created makes two Slam attacks and goes berserk. It rolls for the Berserk trait each round, whether or not it is Bloodied, for 1 minute."
      }
    ],
    "desc": [
      "Size: Small or Medium."
    ],
    "index": "created-2024"
  },
