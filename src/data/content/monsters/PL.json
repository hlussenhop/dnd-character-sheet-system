    "subtype": "human",
    "special_abilities": [
      {
        "name": "Bolster Inventions",
        "desc": "At the end of each of Viktra's turns, each of her Construct allies in a 5-foot Emanation originating from Viktra gains 5 Temporary Hit Points. This trait doesn't function if Viktra has the Incapacitated condition."
      },
      {
        "name": "Darklord Restoration",
        "desc": "If Viktra dies, she revives with all her Hit Points in 1d10 weeks somewhere in Mordenheim Kinetics."
      },
      {
        "name": "Legendary Resistance (3/Day, or 4/Day in Domain)",
        "desc": "If Viktra fails a saving throw, she can choose to succeed instead."
      },
      {
        "name": "Activate Constructs (1/Day)",
        "desc": "Viktra casts Animate Objects, using Intelligence as the spellcasting ability.\n1/day: Animate Objects"
      }
    ],
    "actions": [
      {
        "name": "Multiattack",
        "desc": "Viktra makes two Lightning Rod attacks. She can replace one attack with a use of Syringe."
      },
      {
        "name": "Lightning Rod",
        "desc": "m,r +6, reach 5 ft. or range 90 ft. Hit: 12 (2d8 + 3) Lightning damage, and the target can't take Reactions until the start of its next turn.",
        "attack_bonus": 6
      },
      {
        "name": "Syringe",
        "desc": "con DC 16, one creature Viktra can see within 5 feet.  The target has the Poisoned condition for 1 minute. While Poisoned in this way, the target suffers one of the following effects (Viktra's choice). The target repeats the save at the end of each of its turns, ending the effect on itself on a success. The target succeeds automatically after 1 minute:\nCorrosive Serum: The target takes 10 (4d4) Acid damage at the start of each of its turns, and its Speed decreases by 10 feet.\nDeadly Serum: The target takes 11 (2d10) Necrotic damage at the start of each of its turns, and it can't regain Hit Points.\nMind-Altering Serum: The target takes 10 (3d6) Psychic damage at the start of each of its turns, and it has Disadvantage on saving throws to maintain Concentration."
      }
    ],
    "legendary_actions": [
      {
        "name": "Shocking Prod",
        "desc": "Viktra moves up to half her Speed and makes one Lightning Rod attack. Viktra can't take this action again until the start of her next turn."
      },
      {
        "name": "Static Explosion",
        "desc": "dex DC 16, each creature in a 10-foot-radius Sphere centered on a point Viktra can see within 90 feet.  5 (2d4) Lightning damage.  Half damage."
      }
    ],
